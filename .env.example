# SEAGENT Environment Configuration
# Copy this file to .env and configure your Google Gemini API key

# Required: Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Model name (default: gemini-2.5-flash, supports gemini-1.5-flash, gemini-2.0-flash, etc.)
GEMINI_MODEL=gemini-2.5-flash

# Workflow execution settings
MAX_DEBUG_RETRIES=3
CODE_EXECUTION_TIMEOUT_SECONDS=25
SEAGENT_DATA_DIR=data/workflows
